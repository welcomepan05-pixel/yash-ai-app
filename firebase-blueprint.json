{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "age": { "type": "number" },
        "onboarded": { "type": "boolean" },
        "credits": { "type": "number" },
        "streakCount": { "type": "number" },
        "lastActiveDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A conversation thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "pinned": { "type": "boolean" },
        "folderId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "imageBase64": { "type": "string" },
        "bookmarked": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "role", "content", "createdAt"]
    },
    "GeneratedImage": {
      "title": "Generated Image",
      "description": "An image generated by AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "prompt": { "type": "string" },
        "imageUrl": { "type": "string" },
        "style": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "prompt", "imageUrl", "createdAt"]
    },
    "PhotoEdit": {
      "title": "Photo Edit",
      "description": "A photo edited by AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "originalImageUrl": { "type": "string" },
        "editedImageUrl": { "type": "string" },
        "operation": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "originalImageUrl", "editedImageUrl", "operation", "createdAt"]
    },
    "ChatFolder": {
      "title": "Chat Folder",
      "description": "A folder to organize chats",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "createdAt"]
    },
    "UserMemory": {
      "title": "User Memory",
      "description": "A memory of user preference",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "importance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content", "createdAt"]
    },
    "PromptTemplate": {
      "title": "Prompt Template",
      "description": "A shared prompt in the marketplace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "prompt": { "type": "string" },
        "category": { "type": "string" },
        "likes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "prompt", "createdAt"]
    },
    "UserTask": {
      "title": "User Task",
      "description": "A productivity task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "completed": { "type": "boolean" },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "completed", "createdAt"]
    },
    "StickyNote": {
      "title": "Sticky Note",
      "description": "A digital sticky note",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "color": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content", "color", "createdAt"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "A user badge or achievement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "unlockedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "title", "unlockedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "Chat",
      "description": "User conversations"
    },
    "/users/{userId}/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a conversation"
    },
    "/users/{userId}/generated_images/{imageId}": {
      "schema": "GeneratedImage",
      "description": "Images generated by the user"
    },
    "/users/{userId}/photo_edits/{editId}": {
      "schema": "PhotoEdit",
      "description": "Photos edited by the user"
    },
    "/users/{userId}/folders/{folderId}": {
      "schema": "ChatFolder",
      "description": "User chat folders"
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": "UserMemory",
      "description": "User memories for AI context"
    },
    "/marketplace/{promptId}": {
      "schema": "PromptTemplate",
      "description": "Public prompt marketplace"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "UserTask",
      "description": "User productivity tasks"
    },
    "/users/{userId}/sticky_notes/{noteId}": {
      "schema": "StickyNote",
      "description": "User sticky notes"
    },
    "/users/{userId}/achievements/{achievementId}": {
      "schema": "Achievement",
      "description": "User achievements"
    }
  }
}
